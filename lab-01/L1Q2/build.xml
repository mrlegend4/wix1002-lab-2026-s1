<?xml version="1.0" encoding="UTF-8"?>
<project name="L1Q2" default="jar" basedir=".">

    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${build.dir}"
               includeantruntime="false"/>
    </target>

    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/L1Q2.jar"
             basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="l1q2.MyProfile"/>
            </manifest>
        </jar>
    </target>

</project>
